# Production / demo deployment settings. Enter these in the host's Environment panel (Render, Koyeb),
# never in Git. Generate APP_KEY locally with:  php artisan key:generate --show

APP_NAME="Cinematheque Centre Davao"
APP_ENV=production
APP_KEY=base64:REPLACE_ME
APP_DEBUG=false
APP_URL=https://your-app.onrender.com
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Database: the values from the Clever Cloud MySQL add-on's dashboard (or Aiven's). Only if the provider
# requires TLS (Aiven does), add its CA certificate as a Render Secret File and uncomment the last line.
DB_CONNECTION=mysql
DB_HOST=REPLACE_ME-mysql.services.clever-cloud.com
DB_PORT=3306
DB_DATABASE=REPLACE_ME
DB_USERNAME=REPLACE_ME
DB_PASSWORD=REPLACE_ME
# MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Mail on Render (free tier blocks SMTP): Brevo's HTTPS API. MAIL_FROM_ADDRESS must be a sender
# verified in Brevo (Senders, Domains & Dedicated IPs → Senders).
MAIL_MAILER=brevo
BREVO_API_KEY=xkeysib-REPLACE_ME
MAIL_FROM_ADDRESS=yourname@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Mail elsewhere (laptop, VPS, any host that allows SMTP): Gmail SMTP with an App Password instead.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=yourname@gmail.com
# MAIL_PASSWORD="abcd efgh ijkl mnop"

# PayMongo (test keys for a demo). Register the webhook for checkout_session.payment.paid at
# https://your-app.onrender.com/webhooks/paymongo and paste its secret here.
PAYMONGO_SECRET_KEY=sk_test_REPLACE_ME
PAYMONGO_WEBHOOK_SECRET=whsk_REPLACE_ME
PAYMONGO_PAYMENT_METHODS=gcash,paymaya

# First deploy only: creates the Super Admin, then delete both variables and redeploy.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_PASSWORD
